import numpy as np

# 1. array()
a = np.array([10, 20, 30, 40, 50])
print(a)

# 2. ones()
a = np.ones(5)
print(a)
(it makes all the elements one)

# 3. arange()
a = np.arange(1, 11)
print(a)
(it arrange elements from 1 to 11 without including 11)

# 4. reshape()
a = np.arange(1, 7) = it arrange from 1 to 7 without 1 
b = a.reshape(2, 3)
print(b)
reshape it into 2 rows and 3 columns

# 5. flatten()-copy is created and changes are made in copies.
a = np.array([[1, 2], [3, 4]])
print(a.flatten())

# 6. transpose()
a = np.array([[1, 2, 3], [4, 5, 6]])
print(a.T)
(it changes rows itno columns and columns are changed to row)

# 7. sum()
a = np.array([10, 20, 30, 40])
print(np.sum(a))
(it adds all the numbers of array)

# 8. mean()
print(np.mean(a))
(it calculat mean of the array)

# 9. indexing
print(a[0])
(it prints the no. at zero index)

# 10. slicing
print(a[1:3])
(it prints the numbers from 1 to index 3)

#11.Dimension
print(a.ndim)
(it tells the dimension of the array)

#12.ravel-new copy is not created ,changes are made in original.
b = a.ravel()

print("Original array:")
print(a)

print("After ravel:")
print(b)

# 13.Masking
mask = a > 25

print("Mask:")
print(mask)

print("Elements greater than 25:")
print(a[mask])
(in short it filters the array only print the numbers which are greater than 25 or we can say that is prints ka numbers 
that fullfill the given condition)


import pandas as pd

data = {
    "Name": ["Prachi", "Palak", "Tanish", "Rihan", "Navraj"],
    "Age": [19, 20, 19, 21, 20],
    "Marks": [85, 90, 75, 88, 95],
    "Department": ["IT", "HR", "IT", "Finance", "IT"]
}


df = pd.DataFrame(data)

# 1. DataFrame
print(df)

# 2. head()
print(df.head())
(it prints the upper rows of the data )


# 3. tail()
print(df.tail())
(it prints the bottom rows)

in head and tail if we give the condition of 1 and 2 that speicified upper and lower rows or columns are printed

# 4. shape
print(df.shape)
(it tells us the dimension or structure of the data)


# 5. columns
print(df.columns)
(it shows the list of all coumn headers)

# 6. index
print(df.index)
(Yeh DataFrame ke row numbers Index ki detail deta hai — yaani rows
kahan se start ho rahi hain, kahan khatam, aur kitne step se aage badh rahi hain.

# 7. dtypes
print(df.dtypes)
(it tells the datatype of all columns)

# 8. info()
print(df.info())
(it gives the short summary of the dataframe that how many columns are in it how many null values are present,datatype
of every column)

# 9. Selecting one column
print(df["Name"])
(when we have to extract only one column from data)

# 10. Selecting multiple columns
print(df[["Name", "Marks"]])
(when we have to extract multiple columns)

# 12. loc
print(df.loc[0])

# 13. iloc
print(df.iloc[0])

# 14. Filtering / Masking
print(df[df["Marks"] > 80])
(it only filters and print the data that fullfil the above condition)

# 15. mean()
print(df["Marks"].mean())
(it prints the average of marks column)

# 17. max()
print(df["Marks"].max())
(it prints the max value among the marks)

# 18. min()
print(df["Marks"].min())
(it prints the min value among the marks)

# 19. sum()
print(df["Marks"].sum())
(it prints the sum of th emarks)

# 22. value_counts()
print(df["Department"].value_counts())
(it tells in which column which value is reapeated how many times)

# 23. isnull()
print(df.isnull())
(it checks whether there is any empty values.for every cell True (if it os empty) or
False (it gives data) returns .

# 25. rename()
print(df.rename(columns={"Marks": "Score"}))
(it rename the columns from marks to score)

# 26. groupby()
print(df.groupby("Department")["Marks"].mean())

it has 3 stages-
1.split- it splits the data on the basis of department diff groups are made
2.mean- it apply mean function to LL THE GROUPS And compute the mean
3.combine-it combine all the conditions and give a clean output


